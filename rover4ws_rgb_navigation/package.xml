<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rover4ws_rgb_navigation</name>
  <version>0.2.0</version>
  <description>Steering-aware arc planner, Nav2 global planner/collision monitor config and launch for the RGB-only prototype.</description>
  <maintainer email="info@aisenseusa.com">dharmendra</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rover4ws_gazebo</exec_depend>
  <exec_depend>rover4ws_localization</exec_depend>
  <exec_depend>rover4ws_navigation</exec_depend>
  <exec_depend>rover4ws_rgb_perception</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_smac_planner</exec_depend>
  <exec_depend>nav2_collision_monitor</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rqt_image_view</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
