<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rover4ws_rgb_perception</name>
  <version>0.2.0</version>
  <description>RGB-only perception: SegFormer free space, YOLO objects, corridor/vanishing point, ground-plane optical-flow odometry, object tracking.</description>
  <maintainer email="info@aisenseusa.com">dharmendra</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <!-- pip (user): torch, transformers, ultralytics - see docs/08 -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
