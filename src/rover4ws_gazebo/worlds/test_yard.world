<?xml version="1.0"?>
<!--
  rover4ws test yard.

  NAVIGATION COURSE (robot spawns at 0,0 facing +x; default goal 12,0)
    crate_a   (3.0,  0.0)  directly in the way
    crate_b/c (5.5, +1.0 / -1.6)  a 1.2 m gap to thread
    wall      (8.0, +0.4)  2.6 m wide, forces a detour to the right
    person    (10.0, -0.9)
  SLIP TEST AREA (robot spawns at 1.5, 7 facing +x)
    invisible low-friction patch x 2..9, y 4.5..9.5 (mu 0.05, like wet ice).
    No visual, so the grass texture stays visible for visual odometry.
  OTHER
    kerb (5 cm) and ramp (10 deg) behind the start, for later traversability tests.
  Textured side objects give visual odometry features to track.
-->
<sdf version="1.6">
  <world name="test_yard">

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>38.0</latitude_deg>
      <longitude_deg>-78.5</longitude_deg>
      <elevation>150.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.70 0.80 0.95 1</background>
      <shadows>false</shadows>
    </scene>

    <include><uri>model://sun</uri></include>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grass</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ================= Navigation course ================= -->
    <model name="crate_a">
      <static>true</static>
      <pose>3.0 0.0 0.25 0 0 0.2</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.6 0.6 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 0.6 0.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/WoodPallet</name></script></material></visual>
      </link>
    </model>

    <model name="crate_b">
      <static>true</static>
      <pose>5.5 1.0 0.2 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 1.4 0.4</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 1.4 0.4</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual>
      </link>
    </model>

    <model name="crate_c">
      <static>true</static>
      <pose>5.5 -1.6 0.2 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 1.4 0.4</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 1.4 0.4</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual>
      </link>
    </model>

    <model name="wall">
      <static>true</static>
      <pose>8.0 0.4 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 2.6 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 2.6 0.8</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Bricks</name></script></material></visual>
      </link>
    </model>

    <model name="person">
      <static>true</static>
      <pose>10.0 -0.9 0.85 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.2</radius><length>1.7</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.2</radius><length>1.7</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material></visual>
      </link>
    </model>

    <!-- ================= Slip test area ================= -->
    <model name="ice_patch">
      <static>true</static>
      <pose>5.5 7.0 0.004 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>7.0 5.0 0.008</size></box></geometry>
          <surface><friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction></surface>
        </collision>
      </link>
    </model>

    <!-- ================= Kerb and ramp (behind the start) ================= -->
    <model name="kerb">
      <static>true</static>
      <pose>-3 3 0.025 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.3 4 0.05</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.3 4 0.05</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>

    <model name="ramp">
      <static>true</static>
      <pose>-3 -3 0.0 0 0.175 3.1416</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>2.0 1.2 0.05</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.0 1.2 0.05</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual>
      </link>
    </model>

    <!-- ================= Feature-rich side objects ================= -->
    <model name="shed_far">
      <static>true</static>
      <pose>16 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.0 8.0 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.0 8.0 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Bricks</name></script></material></visual>
      </link>
    </model>

    <model name="fence_right">
      <static>true</static>
      <pose>7 -4.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>14 0.1 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>14 0.1 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/WoodPallet</name></script></material></visual>
      </link>
    </model>

    <model name="fence_slip_end">
      <static>true</static>
      <pose>12 7 0.75 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 6 1.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 6 1.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Bricks</name></script></material></visual>
      </link>
    </model>

    <model name="post_1">
      <static>true</static>
      <pose>4 3.2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.1</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.1</radius><length>1.0</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material></visual>
      </link>
    </model>

    <model name="post_2">
      <static>true</static>
      <pose>8 10.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.1</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.1</radius><length>1.0</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Yellow</name></script></material></visual>
      </link>
    </model>

  </world>
</sdf>
