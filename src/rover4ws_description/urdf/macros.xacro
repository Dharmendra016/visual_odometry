<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="plywood"><color rgba="0.87 0.74 0.55 1.0"/></material>
  <material name="black">  <color rgba="0.08 0.08 0.08 1.0"/></material>
  <material name="grey">   <color rgba="0.55 0.55 0.55 1.0"/></material>
  <material name="white">  <color rgba="0.95 0.95 0.95 1.0"/></material>
  <material name="red">    <color rgba="0.80 0.10 0.10 1.0"/></material>
  <material name="blue">   <color rgba="0.15 0.45 0.85 1.0"/></material>
  <material name="green">  <color rgba="0.10 0.55 0.25 1.0"/></material>

  <!-- Inertia helpers -->
  <xacro:macro name="box_inertia" params="m x y z *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0"
               iyy="${m*(x*x+z*z)/12}" iyz="0"
               izz="${m*(x*x+y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0"
               iyy="${m*(3*r*r+h*h)/12}" iyz="0"
               izz="${m*r*r/2}"/>
    </inertial>
  </xacro:macro>

  <!--
    One steerable corner:
      base_link -[<p>_steer_joint, revolute about z]-> <p>_steer_link
                -[<p>_wheel_joint, continuous about y]-> <p>_wheel_link
    The steering axis passes vertically through the wheel centre (zero scrub radius).
    side = +1 for left wheels, -1 for right wheels.
  -->
  <xacro:macro name="steered_wheel" params="prefix x y side">

    <xacro:property name="bracket_h" value="${deck_clearance - wheel_radius}"/>

    <joint name="${prefix}_steer_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${prefix}_steer_link"/>
      <origin xyz="${x} ${y} 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-max_steer}" upper="${max_steer}"
             effort="${steer_effort}" velocity="${steer_velocity}"/>
      <dynamics damping="0.5" friction="0.0"/>
    </joint>

    <!-- Bracket / steering knuckle - sits on the inner side of the wheel up to the deck -->
    <link name="${prefix}_steer_link">
      <visual>
        <origin xyz="0 ${-side*(wheel_width/2 + 0.012)} ${bracket_h/2}" rpy="0 0 0"/>
        <geometry><box size="0.04 0.012 ${bracket_h}"/></geometry>
        <material name="grey"/>
      </visual>
      <xacro:box_inertia m="${steer_bracket_mass}" x="0.04" y="0.012" z="${bracket_h}">
        <origin xyz="0 ${-side*(wheel_width/2 + 0.012)} ${bracket_h/2}" rpy="0 0 0"/>
      </xacro:box_inertia>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${prefix}_steer_link"/>
      <child link="${prefix}_wheel_link"/>
      <!-- rotate so the cylinder axis (z) points along +y; positive spin = forward roll -->
      <origin xyz="0 0 0" rpy="${-pi/2} 0 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="50.0" velocity="40.0"/>
      <dynamics damping="0.05" friction="0.0"/>
    </joint>

    <link name="${prefix}_wheel_link">
      <visual>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="black"/>
      </visual>
      <!-- hub cap, offset from the axis so the wheel's spin is visible -->
      <visual>
        <origin xyz="${wheel_radius*0.4} 0 0" rpy="0 0 0"/>
        <geometry><box size="${wheel_radius*0.6} 0.02 ${wheel_width + 0.002}"/></geometry>
        <material name="grey"/>
      </visual>
      <collision>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:cylinder_inertia>
    </link>

    <gazebo reference="${prefix}_wheel_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1.0e6</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>1.0</maxVel>
      <material>Gazebo/Black</material>
    </gazebo>
    <gazebo reference="${prefix}_steer_link">
      <material>Gazebo/Grey</material>
    </gazebo>

  </xacro:macro>

</robot>
